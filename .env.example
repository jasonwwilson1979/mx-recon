# .env.example — copy to .env (local) or paste into Portainer stack env
# NEVER commit the real .env file.

# Required in production
DJANGO_SECRET_KEY=change-me-64-random-chars
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,mx-recon.example.com

# Reverse proxy / TLS (enable once your domain resolves over HTTPS)
DJANGO_CSRF_TRUSTED_ORIGINS=https://mx-recon.example.com
DJANGO_TRUST_PROXY=false
DJANGO_SSL_REDIRECT=false
DJANGO_HSTS_SECONDS=0

# Development only — never enable in production
DJANGO_DEBUG=false

# Abuse controls
DJANGO_RATE_LIMIT=30
DJANGO_RATE_WINDOW=300
DJANGO_MAX_QUERIES=350
DJANGO_DEADLINE=30

# Published port on the Docker host (the port you browse to). The container
# itself always listens on 8000. Default when unset: 583.
# MX_RECON_PORT=583

# ---- Resolvers -------------------------------------------------------------
# Resolver pre-selected in the UI dropdown. "system" = this host's own resolver.
DJANGO_RESOLVER_DEFAULT=system
# Add your own resolvers: id|Label|ip[,ip]  (; separates several).
# Spamhaus only answers resolvers it can attribute, so point this at your own
# RECURSIVE resolver if the host itself uses public DNS:
# DJANGO_RESOLVERS_EXTRA=local|Local Unbound 10.0.0.53|10.0.0.53
# Public resolvers used only to retry PTR lookups when the system resolver
# refuses in-addr.arpa queries. Set empty to disable.
DJANGO_DNS_FALLBACK=1.1.1.1,8.8.8.8

# ---- Blacklists ------------------------------------------------------------
# Zones to skip (comma-separated). Also how you turn off the public Spamhaus
# zones once you have moved to DQS:
# DJANGO_RBL_DISABLED=zen.spamhaus.org,dbl.spamhaus.org
# Your own zones, format zone|Label|url (';' separates several, label/url optional).
# IP zones are queried as <reversed-ip>.<zone>, domain zones as <domain>.<zone>.
# DJANGO_RBL_EXTRA_IP=zen.internal.example|Internal IP RBL|https://intranet/rbl
# DJANGO_RBL_EXTRA_DOMAIN=dbl.internal.example|Internal Domain RBL
# Spamhaus DQS (register first; free tier for non-commercial use). Keyed zones
# work from any IP — see README "Spamhaus answers BLOCKED":
# DJANGO_RBL_EXTRA_IP=YOUR-DQS-KEY.zen.dq.spamhaus.net|Spamhaus ZEN (DQS)|https://check.spamhaus.org/
# DJANGO_RBL_EXTRA_DOMAIN=YOUR-DQS-KEY.dbl.dq.spamhaus.net|Spamhaus DBL (DQS)|https://check.spamhaus.org/

# ---- Domain control (RDAP/WHOIS) -------------------------------------------
DJANGO_WHOIS=true
DJANGO_WHOIS_TIMEOUT=6

# ---- Build marker ----------------------------------------------------------
# Shown in the topbar as "BUILD vX.Y.Z" so a stale deploy is obvious.
DJANGO_VERSION=3.11.0
